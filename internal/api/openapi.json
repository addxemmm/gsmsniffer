{
  "openapi": "3.0.3",
  "info": {
    "title": "GSM Sniffer Shielded Laboratory API",
    "version": "2.1",
    "description": "Only for owned test SIMs and terminals inside an RF-shielded room/enclosure. Default demo mode emits synthetic data. No task starts automatically. Identifiers and SMS contents are permanently redacted. Service health does not certify RF readiness. Authentication is configuration-dependent: no token configured means anonymous management access; a configured token requires Bearer authentication. Query GET /api/v1/auth before connecting. Anonymous mode must be limited to a trusted LAN."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current origin: Web 18083 with same-origin API, or API-only 8083 by default."
    },
    {
      "url": "http://{host}:{port}",
      "description": "Direct backend API via localhost/SSH tunnel or explicitly configured trusted LAN HTTP. HTTP sends credentials unencrypted; use HTTPS outside a trusted LAN.",
      "variables": {
        "host": {
          "default": "127.0.0.1"
        },
        "port": {
          "default": "8083"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {}
  ],
