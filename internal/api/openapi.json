        "operationId": "authenticationMode",
        "summary": "Public authentication mode, never token contents",
        "responses": {
          "200": {
            "description": "Whether this deployment requires Bearer authentication",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
