      "get": {
        "operationId": "getOpenAPI",
        "summary": "Read this specification (raw OpenAPI document, not an envelope)",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
