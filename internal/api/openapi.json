  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "At least 32 characters; never put tokens into a URL."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true
          },
          "request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        }
      },
      "JobConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "band",
          "duration_seconds",
          "shielded_ack"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "scan",
              "capture"
            ]
          },
          "band": {
            "type": "string",
            "enum": [
              "GSM900",
              "DCS1800"
            ]
          },
          "frequency_mhz": {
            "type": "number",
            "description": "Capture only: GSM900 925.2–959.8 MHz or DCS1800 1805.2–1879.8 MHz, aligned to 0.2 MHz. Omit for scan."
          },
          "mode": {
            "type": "string",
            "enum": [
              "imsi",
              "sms"
            ],
            "description": "Required for capture; omit for scan."
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600,
            "description": "Cannot exceed configured max_duration_seconds; default server maximum 300."
          },
          "shielded_ack": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Confirm own test equipment in a shielded room/enclosure."
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "state",
          "started_at",
          "config"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "scan",
              "capture"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "finished",
              "cancelled",
              "failed"
            ]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "string"
          },
          "config": {
            "$ref": "#/components/schemas/JobConfig"
          }
        }
      },
      "Observation": {
        "type": "object",
        "required": [
          "kind",
          "timestamp",
          "source"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "frequencies",
              "imsi",
              "sms"
            ]
          },
          "timestamp": {
            "type": "string"
          },
          "identity": {
            "type": "string",
            "description": "Permanently masked identity; never plaintext."
          },
          "text": {
            "type": "string",
            "description": "Redacted SMS event; original content is not exposed."
          },
          "arfcn": {
            "type": "integer"
          },
          "frequency_mhz": {
            "type": "number"
          },
          "cell_id": {
            "type": "string"
          },
          "lac": {
            "type": "string"
          },
          "mcc": {
            "type": "string"
          },
          "mnc": {
            "type": "string"
          },
          "power_dbm": {
            "type": "number"
          },
          "source": {
            "type": "string",
            "enum": [
              "demo",
              "shielded",
              "unknown"
            ],
            "description": "Per-record provenance; demo is synthetic, unknown is legacy state of unverified origin."
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "mode",
          "version",
          "revision",
          "uptime_seconds",
          "active_job"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "shielded"
            ]
          },
          "version": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "uptime_seconds": {
            "type": "integer"
          },
          "active_job": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Job"
              }
            ],
            "nullable": true
          },
          "auth_required": {
            "type": "boolean"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "shielded"
            ]
          },
          "bands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capture_modes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max_duration_seconds": {
            "type": "integer"
          },
          "shielded_ack_required": {
            "type": "boolean"
          },
          "identities_masked": {
            "type": "boolean"
          },
          "sms_redacted": {
            "type": "boolean"
          },
          "binaries": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "rf_validated": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "Jobs": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          }
        }
      },
      "Observations": {
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observation"
            }
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "ready"
        ],
        "properties": {
          "ready": {
            "type": "boolean"
          }
        }
      },
      "AuthMode": {
        "type": "object",
        "required": [
          "required"
        ],
        "properties": {
          "required": {
            "type": "boolean",
            "description": "True only when server has a configured token"
          }
        }
      }
    }
  }
}
