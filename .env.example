# Local configuration only. Copy to .env; never commit .env or secret files.
GSMSNIFFER_IMAGE=gsmsniffer:2.0.0
GSMSNIFFER_BIND=127.0.0.1
GSMSNIFFER_PORT=8080
GSMSNIFFER_MODE=demo
# Absolute HOST path; Compose mounts this file as /run/secrets/api_token.
GSMSNIFFER_TOKEN_PATH=./secrets/api_token
DOCKERHUB_USERNAME=DOCKERHUB_USERNAME
