# Local configuration only. Copy to .env; never commit .env or secret files.
GSMSNIFFER_IMAGE=addxemmm/gsmsniffer:2.1
GSMSNIFFER_BIND=127.0.0.1
GSMSNIFFER_PORT=18083
GSMSNIFFER_API_BIND=127.0.0.1
GSMSNIFFER_API_PORT=8083
GSMSNIFFER_MODE=demo
# Empty token means anonymous access; only use on a trusted isolated LAN.
GSMSNIFFER_TOKEN=
# Optional: load compose.auth.yml to mount a private token file (32+ characters).
# GSMSNIFFER_TOKEN_PATH=/absolute/path/to/secrets/api_token
DOCKERHUB_USERNAME=DOCKERHUB_USERNAME
